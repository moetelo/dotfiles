{
    "layer": "top",
    "position": "bottom",
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/mode"
    ],
    "modules-center": [],
    "modules-right": [
        // "memory",
        "tray",
        "network",
        "battery",
        "hyprland/language",
        "clock#date",
        "clock#time"
    ],
    // "hyprland/workspaces": {
    //     "format": "{id}",
    //     "all-outputs": false
    // },
    "hyprland/window": {
        "max-length": 200,
        "separate-outputs": false
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "network": {
        "interval": 5,
        "format-wifi": "",
        "format-ethernet": " {ifname}",
        "format-disconnected": "Disconnected",
        "format-alt": " {ipaddr}/{cidr}",
        "tooltip": false
    },
    "memory": {
        "interval": 5,
        "format": " {used:0.1f}G/{total:0.1f}G",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip": false
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "hyprland/language": {
        "format": "{short}"
    },

    "clock#date": {
        "interval": 60,
        "format": "{:%Y-%m-%d}",
        // "format": "{:%Y-%m-%e}",
        "tooltip": false
    },

    "clock#time": {
        "interval": 10,
        "format": "{:%H:%M}",
        "tooltip": false
    }
}
