#!/usr/bin/env bash
# csearch <pattern> — full-text search your Claude Code conversations.
# Prints the selected conversation's session id to stdout (resume with:
#   claude --resume <id>   (cd to that project first if it's a different one)
set -uo pipefail

if [ $# -lt 1 ] || [ -z "$1" ]; then
  echo "usage: csearch <pattern>" >&2
  exit 2
fi

pat=$1
root=$HOME/.claude/projects
export CS_PAT=$pat

# jq render: role-prefixed user/assistant text only; skip thinking/tool/attachments.
filter='select(.type=="user" or .type=="assistant") | .type as $role | (.message.content) as $c | (if ($c|type)=="string" then $c else [ $c[]? | select(.type=="text") | .text ] | join("\n") end) as $t | select($t != "") | ("[1m" + ($role|ascii_upcase) + ":[0m " + $t)'

# Preview: matched lines first, then the full transcript (both highlighted).
preview="r=\$(jq -r '$filter' {} 2>/dev/null); printf '%s\n' \"\$r\" | rg -C1 --color=always -S -- \"\$CS_PAT\"; printf '\n──── full transcript ────\n\n'; printf '%s\n' \"\$r\" | rg --passthru --color=always -S -- \"\$CS_PAT\""

sel=$(rg -lS --sortr=modified --glob='*.jsonl' --glob='!**/subagents/**' -- "$pat" "$root" 2>/dev/null \
  | fzf --ansi --preview "$preview" --preview-window 'right:60%:wrap') || exit 0

[ -n "${sel:-}" ] || exit 0
basename "$sel" .jsonl
