{
    "layer": "top",
    "position": "bottom",
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/voxtype",
        "tray",
        "battery",
        "pulseaudio",
        "hyprland/language",
        "clock"
    ],
    "hyprland/workspaces": {
        "format": "{id}"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "custom/voxtype": {
        "exec": "voxtype status --icon-theme nerd-font --format json --extended --follow",
        "return-type": "json",
        "format": "{icon} {}",
        "hide-empty-text": true
    },
    "battery": {
        "format": "󰁹 {capacity}%"
    },
    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰖁 muted"
    },
    "hyprland/language": {
        "format": "{short}"
    },
    "clock": {
        "interval": 10,
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip": false
    }
}
